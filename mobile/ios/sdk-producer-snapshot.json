 "cmake": {
  "minimumVersion": "3.16",
  "generator": "Unix Makefiles",
  "cache": {
   "CMAKE_SYSTEM_NAME": "iOS",
   "CMAKE_BUILD_TYPE": "Release",
   "TESTNET": "ON",
   "BUILD_TESTS": "OFF",
   "BUILD_GUI": "OFF",
   "USE_PCH": "OFF",
   "CAKEWALLET": "OFF",
   "USE_BITCOIN_SECP256K1_FOR_ECDSA": "OFF",
   "DISABLE_TOR": "ON",
   "BUILD_SHARED_LIBS": "OFF",
   "CMAKE_POSITION_INDEPENDENT_CODE": "ON",
   "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
   "CMAKE_TRY_COMPILE_TARGET_TYPE": "STATIC_LIBRARY",
   "CMAKE_CXX_STANDARD": "17",
   "SKIP_BOOST_FATLIB_LIB": "ON",
   "CMAKE_C_FLAGS_RELEASE": "-fembed-bitcode=off",
   "CMAKE_CXX_FLAGS_RELEASE": "-fembed-bitcode=off",
   "REFS": "",
   "GIT": "OFF",
   "COMMIT_ID_IN_VERSION": "ON"
  },
  "why": {
   "deploymentTarget": "The base CMakeLists sets CMAKE_OSX_DEPLOYMENT_TARGET 10.15 for every APPLE build before its iOS branch could choose 12.00. The producer always passes the podspec platform (16.6) explicitly.",
   "bitcode": "The base iOS branch appends -fembed-bitcode to CMAKE_C/CXX_FLAGS. Bitcode is retired in current Xcode. CMAKE_*_FLAGS_RELEASE follows CMAKE_*_FLAGS on the compile line, so -fembed-bitcode=off wins without a CMake source change; produce verifies no __LLVM/__bitcode section remains.",
   "boost": "With SKIP_BOOST_FATLIB_LIB the iOS branch links no libboost.a; the static archives need only Boost headers. Boost archives are packaged per SDK from the dependency inputs.",
   "tryCompile": "iOS executables cannot be linked unsigned during configure checks; static-library try_compile matches the Android producer.",
   "version": "COMMIT is versionCommitLabel (the snapshot root commit). With REFS empty, GIT=OFF and COMMIT_ID_IN_VERSION=ON the root CMakeLists.txt writes BUILD_COMMIT_ID 1.0-g<COMMIT>, so PROJECT_VERSION_LONG equals expectedVersion. check_built_version checks the generated version.h."
  },
  "targets": [
   "wallet",
   "currency_core",
   "crypto",
   "common",
   "zlibstatic"
  ],
  "archives": {
   "zano-wallet": "src/libwallet.a",
   "zano-currency_core": "src/libcurrency_core.a",
   "zano-crypto": "src/libcrypto.a",
   "zano-common": "src/libcommon.a",
   "zano-z": "contrib/zlib/libz.a"
  },
  "installGap": "src/CMakeLists.txt installs only wallet/currency_core/crypto/common for iOS, with no zlib and no headers. The producer packages zlibstatic (libz.a) from the build tree and the header closure from the composed source explicitly; cmake --install is never used."
 },
